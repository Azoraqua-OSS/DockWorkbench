{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DockWorkbench",
  "version": "0.1.0",
  "identifier": "app.dockworkbench",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "pnpm dev:tauri",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "macOSPrivateApi": true,
    "enableGTKAppId": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "dragDropEnabled": true,
        "devtools": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "title": "DockWorkbench",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      },
      {
        "label": "side",
        "create": false,
        "url": "http://127.0.0.1:6006",
        "title": "DockWorkbench Storybook",
        "resizable": true,
        "fullscreen": false,
        "center": false,
        "decorations": true,
        "transparent": false,
        "hiddenTitle": false,
        "devtools": false,
        "dragDropEnabled": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 24
        },
        "width": 420.0,
        "height": 720.0,
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
